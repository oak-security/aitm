# /etc/aitm-web/env — aitm-web configuration (chmod 600 root:root)

AITM_WEB_PORT=8790
AITM_WEB_HOST=127.0.0.1
AITM_WEB_BASE_URL=https://aitm.oaksecurity.io

# GitHub OAuth app (owned by the org; callback: $AITM_WEB_BASE_URL/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign in: org members and/or explicit logins
AITM_ALLOWED_ORGS=oak-security
#AITM_ALLOWED_USERS=

# Server-wide provider keys (users may override with their own in Settings)
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Per-user AI spend limits
AITM_MAX_CONCURRENT_AI=2
#AITM_MAX_AI_PER_DAY=50

# Secret encrypting stored per-user provider keys (default: generated on first boot)
#AITM_KEY_SECRET=
