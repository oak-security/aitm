{
  "name": "@oak-security/aitm-desktop",
  "productName": "AiTM",
  "version": "0.3.0",
  "private": true,
  "description": "AiTM — AI Threat Modeller. Local-first desktop threat modeling using the TRACE framework.",
  "license": "UNLICENSED",
  "author": { "name": "Oak Security", "email": "info@oaksecurity.io" },
  "main": "src/main/index.js",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "aitm": "node packages/cli/src/aitm.js",
    "gui": "electron .",
    "tui": "node packages/cli/src/aitm.js tui",
    "web": "node packages/cli/src/aitm.js web",
    "server": "node packages/cli/src/aitm.js serve",
    "link:cli": "npm link --workspace @oak-security/aitm",
    "check": "node scripts/check-syntax.js",
    "test": "node --test 'test/**/*.test.js'",
    "verify:release": "node scripts/verify-release.js",
    "version:set": "node scripts/set-version.js",
    "pack:check": "node scripts/check-packages.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "publish:ci": "electron-builder --mac --arm64 --publish always"
  },
  "dependencies": {
    "@oak-security/aitm-engine": "0.3.0",
    "@oak-security/aitm-workbench": "0.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
