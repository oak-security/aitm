{
  "name": "@oak-security/aitm",
  "version": "2.0.0",
  "description": "TRACE threat modelling engine, local API server and terminal client.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "aitm": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs/api.md",
    "examples",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "start": "node src/cli.js",
    "aitm": "node src/cli.js",
    "tui": "node src/cli.js",
    "server": "node src/cli.js serve",
    "check": "node scripts/check-syntax.js && prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.js\" package.json",
    "test": "node --test test/*.test.js",
    "test:live": "node scripts/test-live.js",
    "link:cli": "npm link",
    "pack:check": "npm pack --dry-run",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.js\" package.json .prettierrc.json README.md SPEC.md AGENT.md \"docs/*.md\" .github/workflows/ci.yml"
  },
  "dependencies": {
    "ignore": "7.0.8",
    "ink": "7.1.1",
    "ink-text-input": "6.0.0",
    "mammoth": "1.12.2",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.6"
  }
}
