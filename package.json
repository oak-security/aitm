{
  "name": "@oak-security/aitm",
  "version": "2.1.0",
  "description": "TRACE threat modelling engine with local API, terminal and web interfaces.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "license": "MIT",
  "bin": {
    "aitm": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/api.md",
    "docs/usage.md",
    "docs/inputs-and-limits.md",
    "examples",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/cli.js",
    "aitm": "node src/cli.js",
    "tui": "node src/cli.js",
    "server": "node src/cli.js serve",
    "check": "node scripts/check-syntax.js && prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.js\" \"src/web/**/*.{css,html}\" package.json",
    "test": "node --test test/*.test.js",
    "test:live": "node scripts/test-live.js",
    "link:cli": "npm link",
    "doctor": "node src/cli.js doctor",
    "pack:check": "npm pack --dry-run",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.js\" \"src/web/**/*.{css,html}\" package.json .prettierrc.json README.md SPEC.md CONTRIBUTING.md CHANGELOG.md SECURITY.md \"docs/*.md\" .github/workflows/ci.yml",
    "web": "node src/cli.js web",
    "test:web": "node --test test/browser/*.test.js"
  },
  "dependencies": {
    "ignore": "7.0.14",
    "ink": "8.0.0",
    "ink-text-input": "6.0.0",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ink-testing-library": "4.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
