# Optional. The usual setup is `aitm configure`, which saves keys to
# ~/.config/aitm/keys.json (mode 600). Saved keys take precedence over this file.
# To use this file, copy it to .env.local in the directory where you start AiTM
# and run: chmod 600 .env.local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required only for an Anthropic key that is not bound to one workspace.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Server settings, optional. The server binds to loopback only.
# AITM_DATA_DIR=/absolute/path/to/private/data
# AITM_PORT=8790
